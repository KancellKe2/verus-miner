[Unit]
Description=Verus CPU Miner
Documentation=https://docs.verus.io/economy/start-mining.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The installer must be run as root because this service manages
# a system-wide mining process and configuration.
User=root
Group=root

WorkingDirectory=/opt/verus-miner

ExecStart=/opt/verus-miner/miner.sh

# Restart only when the miner exits unexpectedly.
Restart=on-failure
RestartSec=15

# Give the miner time to terminate cleanly.
KillSignal=SIGINT
TimeoutStopSec=30

# Keep CPU scheduling priority below normal workloads.
Nice=10
CPUWeight=50

# Prevent accidental privilege escalation through core dumps.
LimitCORE=0

# Reasonable file descriptor limit for network connections.
LimitNOFILE=65536

# Send stdout/stderr to the system journal.
StandardOutput=journal
StandardError=journal

# Do not start the miner merely because the service file is installed.
# 'systemctl enable' only enables it for boot; start remains explicit.

[Install]
WantedBy=multi-user.target
